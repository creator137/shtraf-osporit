[Unit]
Description=Shtraf.Osporit FastAPI
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=shtraf
Group=shtraf
WorkingDirectory=/opt/shtraf-osporit/backend
EnvironmentFile=/opt/shtraf-osporit/.env
ExecStart=/opt/shtraf-osporit/backend/.venv/bin/uvicorn app.api.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/shtraf-osporit/backend/storage

[Install]
WantedBy=multi-user.target
